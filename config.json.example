{
  "discord": {
    "token": "YOUR_DISCORD_BOT_TOKEN"
  },
  "jellyfin": {
    "enabled": true,
    "announcement_channel_id": 123456789012345678,
    "alert_channel_id": 123456789012345678,
    "urls": [
      "http://primary:8096",
      "http://backup:8096"
    ],
    "api_key": "YOUR_JELLYFIN_API_KEY",
    "description": "Media server",
    "content_types": [
      "Movie",
      "Series",
      "Episode",
      "Audio"
    ],
    "schedule": {
      "announcement_times": [
        "17:00"
      ],
      "suggestion_times": [
        "12:00",
        "20:00"
      ],
      "timezone": "America/Los_Angeles",
      "health_check_interval_minutes": 5,
      "lookback_hours": 24,
      "max_items_per_type": 10
    }
  },
  "minecraft": {
    "enabled": true,
    "announcement_channel_id": 123456789012345678,
    "alert_channel_id": 123456789012345678,
    "servers": [
      {
        "name": "Survival",
        "urls": [
          "mc.example.com:25565",
          "backup-mc.example.com:25565"
        ],
        "description": "Main survival world"
      },
      {
        "name": "Creative",
        "urls": [
          "creative.example.com:25565"
        ],
        "description": "Creative building"
      }
    ],
    "schedule": {
      "timezone": "America/Los_Angeles",
      "health_check_interval_minutes": 1,
      "player_check_interval_seconds": 30
    }
  },
  "nextcloud": {
    "enabled": false,
    "urls": [
      "https://nextcloud.example.com"
    ],
    "admin_user": "YOUR_NEXTCLOUD_ADMIN_USER",
    "admin_password": "YOUR_NEXTCLOUD_ADMIN_PASSWORD",
    "description": "File sync and share"
  },
  "navidrome": {
    "enabled": false,
    "urls": [
      "https://navidrome.example.com"
    ],
    "admin_user": "YOUR_NAVIDROME_ADMIN_USER",
    "admin_password": "YOUR_NAVIDROME_ADMIN_PASSWORD",
    "description": "Music streaming"
  },
  "organizr": {
    "enabled": false,
    "urls": ["https://organizr.example.com"],
    "admin_user": "YOUR_ORGANIZR_ADMIN_USER",
    "admin_password": "YOUR_ORGANIZR_ADMIN_PASSWORD",
    "description": "Services dashboard"
  },
  "romm": {
    "enabled": false,
    "urls": [
      "https://romm.example.com"
    ],
    "admin_user": "YOUR_ROMM_ADMIN_USER",
    "admin_password": "YOUR_ROMM_ADMIN_PASSWORD",
    "description": "ROM library manager"
  },
  "radarr": {
    "enabled": false,
    "url": "http://radarr:7878",
    "api_key": "YOUR_RADARR_API_KEY",
    "root_folder_path": "/movies",
    "quality_profile_id": 1
  },
  "sonarr": {
    "enabled": false,
    "url": "http://sonarr:8989",
    "api_key": "YOUR_SONARR_API_KEY",
    "root_folder_path": "/tv",
    "quality_profile_id": 1
  },
  "registration": {
    "enabled": false
  },
  "admin_ui": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 5050,
    "admin_login_file": "data/admin-login.json"
  },
  "logging": {
    "log_directory": "logs",
    "log_level": "INFO",
    "log_to_console": true,
    "log_to_file": true
  },
  "additional_links": [
    {
      "name": "Wiki",
      "url": "https://wiki.example.com",
      "description": "Documentation and guides"
    },
    {
      "name": "Status Page",
      "url": "https://status.example.com",
      "description": "Service status and uptime"
    }
  ]
}
